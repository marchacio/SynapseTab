{
  "name": "synapsetab-monorepo",
  "version": "1.0.0",
  "description": "Ultra-lightweight, self-hosted tab and workspace synchronization for Mozilla Firefox",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "extension"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,extension\" -c \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=extension\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:extension": "npm run dev --workspace=extension",
    "dev:client-a": "npm run dev:client-a --workspace=extension",
    "dev:client-b": "npm run dev:client-b --workspace=extension",
    "build": "npm run build --workspaces",
    "build:server": "npm run build --workspace=server",
    "build:extension": "npm run build --workspace=extension",
    "test": "npm run test --workspaces",
    "test:extension": "npm run test --workspace=extension",
    "test:server": "npm run test --workspace=server",
    "lint": "npm run lint --workspaces",
    "lint:extension": "npm run lint --workspace=extension",
    "lint:web-ext": "npm run lint:web-ext --workspace=extension"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
